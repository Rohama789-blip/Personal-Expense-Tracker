{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "^/app$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "^/style\\.css$",
      "dest": "/frontend/style.css"
    },
    {
      "src": "^/script\\.js$",
      "dest": "/frontend/script.js"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}